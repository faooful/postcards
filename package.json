{
  "name": "postcards",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "validate": "node scripts/validate.mjs",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "postcard": "node scripts/write-postcard.mjs",
    "test": "node --test tests/*.test.mjs",
    "delivery:status": "node scripts/delivery-status.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
