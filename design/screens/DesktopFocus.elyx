p_70 = text {
  left: 12px,
  top: 301.25px,
  width: 764px,
  contents: "Overnight in Marrow Bend, the council traded the names of Brass Bell Row and\nCordage Way, and by morning half the town stood on corners that belonged to\nsomebody else's memories. Edda, the postmistress, walked her route with both\ndirectories under one arm and a pencil behind each ear. She matched every envelope\nto its new home, humming, unhurried, pausing only to admire the confusion she was\nsteadily curing. By dusk the last letter had landed in its rightful slot, and the two\nstreets — strangers all afternoon — waved to each other across the rooftops like\ncousins finally introduced.",
  font-family: "Georgia",
  font-size: 20,
  line-height: 1.35,
  fill: rgb(9.8%, 9.8%, 9.8%)
}

signature_71 = text {
  left: 12px,
  top: 557.25px,
  width: 764px,
  contents: "Till we meet again,\nPi",
  font-family: "Georgia",
  font-size: 20,
  line-height: 1.35,
  fill: rgb(9.8%, 9.8%, 9.8%)
}

