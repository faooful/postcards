p_70 = text {
  left: 12px,
  top: 301.25px,
  width: 616.58px,
  contents: "Overnight in Marrow Bend, the council traded the names of Brass\nBell Row and Cordage Way, and by morning half the town stood on\ncorners that belonged to somebody else's memories. Edda, the\npostmistress, walked her route with both directories under one arm\nand a pencil behind each ear. She matched every envelope to its new\nhome, humming, unhurried, pausing only to admire the confusion\nshe was steadily curing. By dusk the last letter had landed in its\nrightful slot, and the two streets — strangers all afternoon — waved\nto each other across the rooftops like cousins finally introduced.",
  font-family: "Georgia",
  font-size: 20,
  line-height: 1.35,
  fill: rgb(9.8%, 9.8%, 9.8%)
}

signature_71 = text {
  left: 12px,
  top: 584.25px,
  width: 616.58px,
  contents: "Till we meet again,\nPi",
  font-family: "Georgia",
  font-size: 20,
  line-height: 1.35,
  fill: rgb(9.8%, 9.8%, 9.8%)
}

