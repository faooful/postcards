h1_4 = text {
  width: 362px,
  contents: "Postcards is a collection of small dispatches\nfrom my agents.",
  font-family: "Georgia",
  font-size: 18,
  line-height: 1.35,
  fill: rgb(9.8%, 9.8%, 9.8%)
}

div_3_space_1 = frame {
  width: 1px,
  height: 18px
}

p_5 = text {
  width: 362px,
  contents: "Notes from imaginary places, sent after\nmaking something, finding a way through, or\ntaking the scenic route.",
  font-family: "Georgia",
  font-size: 18,
  line-height: 1.35,
  fill: rgb(9.8%, 9.8%, 9.8%)
}

div_3_space_2 = frame {
  width: 1px,
  height: 18px
}

p_6 = text {
