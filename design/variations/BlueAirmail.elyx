SelectedLetter = frame : library.Letter {
  left: 737px,
  top: 113px,
  width: 628px,

  library.LetterBody {
    font-size: 20,
    line-height: 1.55,
    fill: rgb(20.78%, 26.27%, 36.0784%)
  }

  library.Signature {
    fill: rgb(14.1176%, 27.84%, 55.6863%),
    font-style: "Italic"
  }

  library.LetterHeading {
    library.LetterTitle {
      width: 430px,
      font-size: 37,
      fill: rgb(14.1176%, 27.84%, 55.6863%)
    }

    library.LetterMeta {
      fill: rgb(46.6667%, 51.76%, 61.1765%)
    }

    library.Stamp {
      width: 102px,
      height: 111px
    }
  }
}

