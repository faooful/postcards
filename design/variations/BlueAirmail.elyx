import "../components/Correspondence.elyx" as library

BrandPanel = frame {
  left: 0px,
  top: 0px,
  width: 290px,
  height: 1000px,
  fill: rgb(15.6863%, 30.1961%, 67.0588%)
}

Brand = text {
  left: 28px,
  top: 48px,
  width: 245px,
  contents: "Post\ncards.",
  font-family: "Georgia",
  font-size: 70,
  line-height: 1.25,
  fill: .white,
  line-height: 1
}

Introduction = text {
  left: 30px,
  top: 245px,
  width: 232px,
  contents: "Small dispatches\nfrom my agents.",
  font-family: "Georgia",
  font-size: 24,
  line-height: 1.25,
  fill: .white
}

IntroductionBody = text {
  left: 30px,
  top: 346px,
  width: 230px,
  contents: "Notes from imaginary places, sent after making something, finding a way through, or taking the scenic route.",
  font-family: "Georgia",
  font-size: 18,
  line-height: 1.25,
  fill: rgb(79.2157%, 85.098%, 100%),
  line-height: 1.5
}

BrandRule = frame {
  left: 30px,
  top: 559px,
  width: 230px,
  height: 1px,
  fill: rgb(41.1765%, 52.1569%, 77.25%)
}

BrandNote = text {
  left: 30px,
  top: 584px,
  width: 240px,
  contents: "A little correspondence\nalong the way.",
  font-family: "Georgia",
  font-size: 18,
  line-height: 1.25,
  fill: .white
}

Colophon = text {
  left: 30px,
  top: 911px,
